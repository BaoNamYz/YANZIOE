{
  "manifest_version": 3,
  "name": "YANZIOE VIP CoKey VIP - IOE.vn Tool",
  "version": "1.2.6",
  "description": "Tool tự giải và hiển thị đáp án Olympic Tiếng Anh IOE.vn (Cocos2d, CreateJS & DOM)",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://ioe.vn/*",
        "*://*.ioe.vn/*",
        "*://*.go.vn/*",
        "*://*.vtc.vn/*",
        "*://*.vtconline.vn/*",
        "*://vtconline.vn/*",
        "*://*.goplay.vn/*",
        "*://api-edu.go.vn/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    },
    {
      "matches": [
        "*://ioe.vn/*",
        "*://*.ioe.vn/*",
        "*://*.go.vn/*",
        "*://*.vtc.vn/*",
        "*://*.vtconline.vn/*",
        "*://vtconline.vn/*",
        "*://*.goplay.vn/*",
        "*://api-edu.go.vn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "host_permissions": [
    "*://ioe.vn/*",
    "*://*.ioe.vn/*",
    "*://*.go.vn/*",
    "*://*.vtc.vn/*",
    "*://*.vtconline.vn/*",
    "*://vtconline.vn/*",
    "*://*.goplay.vn/*",
    "*://api-edu.go.vn/*",
    "https://yanzbnshop.onrender.com/*",
    "https://api.groq.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://aiplatform.googleapis.com/*",
    "https://openrouter.ai/*",
    "https://*/*"
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "YANZIOE.js",
        "bridge.js"
      ],
      "matches": [
        "*://ioe.vn/*",
        "*://*.ioe.vn/*",
        "*://*.go.vn/*",
        "*://*.vtc.vn/*",
        "*://*.vtconline.vn/*",
        "*://vtconline.vn/*",
        "*://*.goplay.vn/*",
        "*://api-edu.go.vn/*"
      ]
    }
  ]
}