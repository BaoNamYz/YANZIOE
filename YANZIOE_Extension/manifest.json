{
  "manifest_version": 3,
  "name": "YANZIOE VIP  - IOE.vn Tool",
  "version": "1.0.2",
  "description": "Tool tự giải và hiển thị đáp án Olympic Tiếng Anh IOE.vn (Cocos2d, CreateJS & DOM)",
  "content_scripts": [
    {
      "matches": [
        "*://ioe.vn/*",
        "*://*.ioe.vn/*",
        "*://*.go.vn/*",
        "*://*.vtc.vn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "permissions": [
    "activeTab",
    "scripting"
  ]
}