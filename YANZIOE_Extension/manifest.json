{
  "manifest_version": 3,
  "name": "YANZIOE VIP  - IOE.vn Tool",
  "version": "1.0.7",
  "description": "Tool tự giải và hiển thị đáp án Olympic Tiếng Anh IOE.vn (Cocos2d, CreateJS & DOM)",
  "content_scripts": [
    {
      "matches": [
        "*://ioe.vn/*",
        "*://*.ioe.vn/*",
        "*://*.go.vn/*",
        "*://*.vtc.vn/*",
        "*://api-edu.go.vn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "host_permissions": [
    "*://ioe.vn/*",
    "*://*.ioe.vn/*",
    "*://*.go.vn/*",
    "*://*.vtc.vn/*",
    "*://api-edu.go.vn/*",
    "https://api.groq.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*"
  ],
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content.js",
        "YANZIOE.js"
      ],
      "matches": [
        "*://ioe.vn/*",
        "*://*.ioe.vn/*",
        "*://*.go.vn/*",
        "*://*.vtc.vn/*",
        "*://api-edu.go.vn/*"
      ]
    }
  ]
}